-- 1: Subquery to find department name of employee 'MILLER'
SQL> SELECT DNAME
  2  FROM DEPT
  3  WHERE DEPTNO = (SELECT DEPTNO
  4                  FROM EMP
  5                  WHERE ENAME = 'MILLER');

DNAME                                                                           
--------------                                                                  
ACCOUNTING                                                                      

-- 2: Compound condition using AND operator across two different job/dept combinations
SQL> SELECT *
  2  FROM EMP
  3  WHERE (JOB = 'MANAGER' AND DEPTNO = 10) AND (JOB = 'ANALYST' AND DEPTNO = 20);

no rows selected

-- 3: Compound condition using OR operator to fetch Managers in Dept 10 or Analysts in Dept 20
SQL> SET LINES 100 PAGES 100
SQL> SELECT *
  2  FROM EMP
  3  WHERE (JOB = 'MANAGER' AND DEPTNO = 10) OR (JOB = 'ANALYST' AND DEPTNO = 20);

     EMPNO ENAME      JOB              MGR HIREDATE         SAL       COMM     DEPTNO               
---------- ---------- --------- ---------- --------- ---------- ---------- ----------               
      7782 CLARK      MANAGER         7839 09-JUN-81       2450                    10               
      7788 SCOTT      ANALYST         7566 19-APR-87       3000                    20               
      7902 FORD       ANALYST         7566 03-DEC-81       3000                    20               

-- 4: Subquery to find location (LOC) of employee 'ADAMS'
SQL> SELECT LOC
  2  FROM DEPT
  3  WHERE DEPTNO = (SELECT DEPTNO
  4                  FROM EMP
  5                  WHERE ENAME = 'ADAMS');

LOC                                                                                                 
-------------                                                                                       
DALLAS                                                                                              

-- 5: Subquery to find employees in Dept 20 earning more than 'SCOTT'
SQL> SELECT ENAME, SAL
  2  FROM EMP
  3  WHERE DEPTNO = 20 AND SAL > (SELECT SAL
  4                               FROM EMP
  5                               WHERE ENAME = 'SCOTT');

no rows selected

-- 6: Subquery with aggregate MAX() to find highest paid employee
SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE SAL = (SELECT MAX(SAL)
  4               FROM EMP);

ENAME                                                                                               
----------                                                                                          
KING                                                                                                

-- 7: Multiple subqueries inside IN clause (Minimum or Average salary)
SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE SAL IN ((SELECT MIN(SAL)
  4                 FROM EMP), (SELECT AVG(SAL)
  5                             FROM EMP));

ENAME                                                                                               
----------                                                                                          
SMITH                                                                                               

-- 8: 2nd Highest Salary using nested subquery
SQL> SELECT ENAME, SAL
  2  FROM EMP
  3  WHERE SAL = (SELECT MAX(SAL)
  4               FROM EMP
  5               WHERE SAL < (SELECT MAX(SAL)
  6                            FROM EMP));

ENAME             SAL                                                                               
---------- ----------                                                                               
SCOTT            3000                                                                               
FORD             3000                                                                               

-- 9: 5th Distinct Maximum Salary using 5-level deep nested subquery
SQL> SELECT ENAME, SAL
  2  FROM EMP
  3  WHERE SAL = (SELECT MAX(SAL)
  4               FROM EMP
  5               WHERE SAL < (SELECT MAX(SAL)
  6                            FROM EMP
  7                            WHERE SAL < (SELECT MAX(SAL)
  8                                         FROM EMP
  9                                         WHERE SAL < (SELECT MAX(SAL)
 10                                                      FROM EMP
 11                                                      WHERE SAL < (SELECT MAX(SAL)
 12                                                                   FROM EMP)))));

ENAME             SAL                                                                                                                                                                                                                                                                                       
---------- ----------                                                                                                                                                                                                                                                                                       
CLARK            2450                                                                                                                                                                                                                                                                                       

-- 10: 3rd Minimum Salary using 3-level nested subquery
SQL> SELECT ENAME, SAL
  2  FROM EMP
  3  WHERE SAL = (SELECT MIN(SAL)
  4               FROM EMP
  5               WHERE SAL > (SELECT MIN(SAL)
  6                            FROM EMP
  7                            WHERE SAL > (SELECT MIN(SAL)
  8                                         FROM EMP
  9                                         )));

ENAME             SAL                                                                                                                                                                                                                                                                                       
---------- ----------                                                                                                                                                                                                                                                                                       
ADAMS            1100                                                                                                                                                                                                                                                                                       

-- 11: Employee with Minimum Salary
SQL> SELECT ENAME, SAL
  2  FROM EMP
  3  WHERE SAL = (SELECT MIN(SAL)
  4               FROM EMP);

ENAME             SAL                                                                                                                                                                                                                                                                                       
---------- ----------                                                                                                                                                                                                                                                                                       
SMITH             800                                                                                                                                                                                                                                                                                       

-- 12: Self-referencing subquery to find Manager of 'ALLEN'
SQL>  SELECT ENAME
  2  FROM EMP
  3  WHERE EMPNO = (SELECT MGR
  4                 FROM EMP
  5                 WHERE ENAME = 'ALLEN');

ENAME                                                                                                                                                                                                                                                                                                       
----------                                                                                                                                                                                                                                                                                                  
BLAKE                                                                                                                                                                                                                                                                                                       

-- 13: Self-referencing subquery to find Manager name and salary of 'SMITH'
SQL> SELECT ENAME, SAL
  2  FROM EMP
  3  WHERE EMPNO = (SELECT MGR
  4                 FROM EMP
  5                 WHERE ENAME = 'SMITH');

ENAME             SAL                                                                                                                                                                                                                                                                                       
---------- ----------                                                                                                                                                                                                                                                                                       
FORD             3000                                                                                                                                                                                                                                                                                       

-- 14: Hierarchical Subquery to find Manager's Manager of 'SMITH'
SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE EMPNO IN (SELECT MGR
  4                  FROM EMP
  5                  WHERE EMPNO IN (SELECT MGR
  6                                  FROM EMP
  7                                  WHERE ENAME = 'SMITH'));

ENAME                                                                                                                                                                                                                                                                                                       
----------                                                                                                                                                                                                                                                                                                  
JONES                                                                                                                                                                                                                                                                                                       

-- 15: Cross-table subquery to find Department Name of 'KING's Manager
SQL> SELECT DNAME
  2  FROM DEPT
  3  WHERE DEPTNO IN (SELECT DEPTNO
  4                   FROM EMP
  5                   WHERE EMPNO IN (SELECT MGR
  6                                   FROM EMP
  7                                   WHERE ENAME = 'KING'));

no rows selected

-- 16: Subquery to find employees reporting to 'JAMES'
SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE MGR IN (SELECT EMPNO
  4                FROM EMP
  5                WHERE ENAME = 'JAMES');

no rows selected

-- 17: 4-level Cross-table Subquery to find Location of Manager's Manager of 'ADAM'
SQL> SELECT LOC
  2  FROM DEPT
  3  WHERE DEPTNO IN (SELECT DEPTNO
  4                   FROM EMP
  5                   WHERE EMPNO IN (SELECT MGR
  6                                   FROM EMP
  7                                   WHERE EMPNO IN (SELECT MGR
  8                                                   FROM EMP
  9                                                   WHERE ENAME = 'ADAM')));

no rows selected

