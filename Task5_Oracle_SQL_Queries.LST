-- 30: Multiple subqueries combining EMP job match and DEPT location match
SQL> SELECT *
  2  FROM EMP
  3  WHERE JOB = (SELECT JOB
  4               FROM EMP
  5               WHERE ENAME = 'MILLER') AND DEPTNO = (SELECT DEPTNO
  6                                                     FROM DEPT
  7                                                     WHERE LOC = 'NEW YORK');

     EMPNO ENAME      JOB              MGR HIREDATE         SAL       COMM     DEPTNO                                                                                                                                                                                                                       
---------- ---------- --------- ---------- --------- ---------- ---------- ----------                                                                                                                                                                                                                       
      7934 MILLER     CLERK           7782 23-JAN-82       1300                    10                                                                                                                                                                                                                       

-- 31: Nested IN subquery to find Manager's Manager of 'SMITH'
SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE EMPNO IN (SELECT MGR
  4                  FROM EMP
  5                  WHERE EMPNO IN (SELECT MGR
  6                                  FROM EMP
  7                                  WHERE ENAME = 'SMITH'));

