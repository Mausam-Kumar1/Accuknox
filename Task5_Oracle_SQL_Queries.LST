SQL> SELECT ENAME, DEPTNO
  2  FROM EMP
  3  WHERE COMM IS NOT NULL AND DEPTNO IN (SELECT DEPTNO
  4                                        FROM EMP
  5                                        GROUP BY DEPTNO);

