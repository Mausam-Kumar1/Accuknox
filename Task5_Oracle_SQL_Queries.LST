MARTIN           1250       1400                                                                                                                                                                                                                                                                            

-- 24: Pattern matching (LIKE) with GROUP BY and HAVING clause
SQL> SELECT DEPTNO, COUNT(*)
  2  FROM EMP
  3  WHERE ENAME LIKE '%A%' OR ENAME LIKE '%S%'
  4  GROUP BY DEPTNO
  5  HAVING COUNT(*) >= 2;

    DEPTNO   COUNT(*)                                                                                                                                                                                                                                                                                       
---------- ----------                                                                                                                                                                                                                                                                                       
        30          5                                                                                                                                                                                                                                                                                       
        20          4                                                                                                                                                                                                                                                                                       

-- 25: Department-wise employee count having at least 3 employees
SQL> SELECT DEPTNO, COUNT(*)
  2  FROM EMP
  3  GROUP BY DEPTNO
  4  HAVING COUNT(*) >= 3;

    DEPTNO   COUNT(*)                                                                                                                                                                                                                                                                                       
---------- ----------                                                                                                                                                                                                                                                                                       
        30          6                                                                                                                                                                                                                                                                                       
        20          5                                                                                                                                                                                                                                                                                       
        10          3                                                                                                                                                                                                                                                                                       

-- 26: Filtering non-null commissions with grouped department subquery
SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE COMM IS NOT NULL AND DEPTNO IN (SELECT DEPTNO
  4                                        FROM EMP
  5                                        GROUP BY DEPTNO);

ENAME                                                                                                                                                                                                                                                                                                       
----------                                                                                                                                                                                                                                                                                                  
