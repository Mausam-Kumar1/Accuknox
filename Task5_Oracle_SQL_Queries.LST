TURNER           1500          0                                                                                                                                                                                                                                                                            

-- 23: Employee with Maximum Commission
SQL> SELECT ENAME, SAL, COMM
  2  FROM EMP
  3  WHERE COMM = (SELECT MAX(COMM)
  4                FROM EMP);

ENAME             SAL       COMM                                                                                                                                                                                                                                                                            
